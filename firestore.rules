rules_version = '2';

// Firestore security rules for Kehila Hub.
//
// Role-based access enforced on the server. Roles live in users/{uid}.role
// ('admin' | 'guide' | 'viewer'); a removed guide has users/{uid}.disabled ===
// true and is treated as "no access" — disabled users can't even read data.
//
// NOTE: the first admin's users/{uid} document must be created manually in the
// Firebase Console. Review and test in the Emulator / a test project before
// deploying to production.
service cloud.firestore {
  match /databases/{database}/documents {

    // Is anyone signed in?
    function signedIn() {
      return request.auth != null;
    }

    // The signed-in user's profile document data.
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A signed-in user who has a profile and is NOT disabled. Uses .get() with
    // defaults so a profile missing the 'disabled' field still counts as active
    // (admins are created without that field).
    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().get('disabled', false) != true;
    }

    // An active user with the given role (a missing 'role' counts as no role).
    function hasRole(role) {
      return isActiveUser() && profile().get('role', '') == role;
    }

    // An active admin.
    function isAdmin() {
      return hasRole('admin');
    }

    // An active admin or guide.
    function isStaff() {
      return hasRole('admin') || hasRole('guide');
    }

    // Helper to check if the signed-in guide is assigned to the given group ID.
    // Looks up both the guide's mapping document and the group's guideId field.
    function isGuideOfGroup(groupId) {
      return hasRole('guide')
        && (
             (exists(/databases/$(database)/documents/guides/$(request.auth.uid))
              && get(/databases/$(database)/documents/guides/$(request.auth.uid)).data.get('groupId', '') == groupId)
             || (exists(/databases/$(database)/documents/groups/$(groupId))
                 && get(/databases/$(database)/documents/groups/$(groupId)).data.get('guideId', '') == request.auth.uid)
           );
    }

    // A strict 'YYYY-MM-DD' that is a REAL Gregorian date and NOT a Saturday.
    // The parts are parsed from the string and round-tripped through
    // timestamp.date(...): an impossible date (e.g. 2026-02-30) rolls over so a
    // component no longer matches and is rejected. dayOfWeek() of that calendar
    // date is timezone-independent, so a Saturday key is rejected here too
    // (Firestore Rules dayOfWeek: 1=Mon .. 7=Sun, so Saturday == 6).
    function isRealNonSaturdayDateKey(dateKey) {
      return dateKey is string
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10])).year() == int(dateKey[0:4])
        && timestamp.date(int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10])).month() == int(dateKey[5:7])
        && timestamp.date(int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10])).day() == int(dateKey[8:10])
        && timestamp.date(int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10])).dayOfWeek() != 6;
    }

    // A complete, well-typed attendance payload: exactly the eight known fields,
    // non-empty strings of the right type, a boolean status, a timestamp date,
    // and a real non-Saturday dateKey. The group's name fields must match the
    // canonical group document, the volunteer must exist and belong to the same
    // group BY groupId ONLY (no name fallback), and volunteerName must match the
    // volunteer document's canonical 'name'. (Identical get()/exists() calls are
    // cached within one evaluation, so repeating them is cheap.)
    function attendancePayloadValid(data) {
      return data.keys().hasOnly(['groupId', 'group', 'groupName', 'date', 'dateKey', 'status', 'volunteerId', 'volunteerName'])
        && data.keys().hasAll(['groupId', 'group', 'groupName', 'date', 'dateKey', 'status', 'volunteerId', 'volunteerName'])
        && data.groupId is string && data.groupId.size() > 0
        && data.group is string && data.group.size() > 0
        && data.groupName is string && data.groupName.size() > 0
        && data.volunteerId is string && data.volunteerId.size() > 0
        && data.volunteerName is string && data.volunteerName.size() > 0
        && data.status is bool
        && data.date is timestamp
        && isRealNonSaturdayDateKey(data.dateKey)
        && exists(/databases/$(database)/documents/groups/$(data.groupId))
        && get(/databases/$(database)/documents/groups/$(data.groupId)).data.get('groupName', '') == data.group
        && get(/databases/$(database)/documents/groups/$(data.groupId)).data.get('groupName', '') == data.groupName
        && exists(/databases/$(database)/documents/volunteers/$(data.volunteerId))
        && get(/databases/$(database)/documents/volunteers/$(data.volunteerId)).data.get('groupId', '') == data.groupId
        && get(/databases/$(database)/documents/volunteers/$(data.volunteerId)).data.get('name', '') == data.volunteerName;
    }

    // A guide CREATING a new own-group record. The document id MUST be the
    // canonical groupId_dateKey_volunteerId (compared as one whole string, so
    // underscores inside groupId/volunteerId are never an issue).
    function guideAttendanceCreate(id, data) {
      return hasRole('guide')
        && attendancePayloadValid(data)
        && isGuideOfGroup(data.groupId)
        && id == data.groupId + '_' + data.dateKey + '_' + data.volunteerId;
    }

    // A guide UPDATING an existing own-group record: identity (groupId,
    // volunteerId, dateKey) is immutable, BOTH the existing and the new record
    // belong to the guide's group, and the new payload is fully valid. The
    // existing document id need NOT be canonical, so legacy records stay editable.
    function guideAttendanceUpdate(data, existing) {
      return hasRole('guide')
        && attendancePayloadValid(data)
        && isGuideOfGroup(data.groupId)
        && isGuideOfGroup(existing.get('groupId', ''))
        && data.groupId == existing.get('groupId', '')
        && data.volunteerId == existing.get('volunteerId', '')
        && data.dateKey == existing.get('dateKey', '');
    }


    // Active community groups — shown on the public home page, so anyone may
    // read them; only an admin may change them.
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public volunteer sign-up: anyone may create a registration, but only with
    // the expected fields (blocks spam / malformed docs). Admin only otherwise.
    match /registrants/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'firstName', 'lastName', 'email', 'phone', 'status',
            'age', 'birthDate', 'experience', 'address', 'school',
            'day', 'programId', 'programName', 'createdAt'
          ])
        && request.resource.data.keys().hasAll(['firstName', 'lastName', 'email', 'phone', 'age', 'status', 'createdAt'])
        // Required text fields, with sane length caps (it's a public endpoint).
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 60
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 6 && request.resource.data.phone.size() <= 25
        // A new registration is always "pending"; no other status allowed.
        && request.resource.data.status == 'ממתין לאישור'
        // A plausible age + a short birth-date string.
        && request.resource.data.age is number
        && request.resource.data.age >= 0 && request.resource.data.age <= 120
        && request.resource.data.birthDate is string && request.resource.data.birthDate.size() <= 20
        // Day, programId, and programName validations (if present).
        && (!('day' in request.resource.data) || (request.resource.data.day is string && request.resource.data.day.size() <= 40))
        && (!('programId' in request.resource.data) || (request.resource.data.programId is string && request.resource.data.programId.size() <= 80))
        && (!('programName' in request.resource.data) || (request.resource.data.programName is string && request.resource.data.programName.size() <= 120))
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // Public signed volunteer forms: anyone with the link may submit one signed
    // form (create only); only an admin may read them. A strict field allowlist
    // + size caps keep this safe as a public endpoint. NOTE: requires deploying
    // these rules (firebase deploy --only firestore:rules) before submissions
    // can be stored on the server.
    match /signedForms/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'registrantId', 'fullName', 'firstName', 'lastName',
            'idNumber', 'age', 'birthDateGreg', 'birthDateHeb',
            'address', 'phone', 'email', 'school', 'shirtSize',
            'groupName', 'activityDays', 'agreed', 'signature',
            'pdfStoragePath', 'pdfFileName', 'createdAt'
          ])
        && request.resource.data.keys().hasAll([
            'registrantId', 'fullName', 'firstName', 'lastName',
            'idNumber', 'age', 'birthDateGreg', 'birthDateHeb',
            'address', 'phone', 'email', 'school', 'shirtSize',
            'groupName', 'activityDays', 'agreed', 'signature',
            'pdfStoragePath', 'pdfFileName', 'createdAt'
          ])
        && request.resource.data.registrantId is string
        && request.resource.data.registrantId.size() <= 120
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 60
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 60
        && request.resource.data.idNumber is string
        && request.resource.data.idNumber.matches('[0-9]{9}')
        && request.resource.data.age is number
        && request.resource.data.age >= 0
        && request.resource.data.age <= 120
        && request.resource.data.birthDateGreg is string
        && request.resource.data.birthDateGreg.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        // Hebrew date is optional in the UI; an empty string is valid.
        && request.resource.data.birthDateHeb is string
        && request.resource.data.birthDateHeb.size() <= 80
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 180
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 25
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.school is string
        && request.resource.data.school.size() > 0
        && request.resource.data.school.size() <= 160
        && request.resource.data.shirtSize in ['XS', 'S', 'M', 'L', 'XL', 'XXL']
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() > 0
        && request.resource.data.groupName.size() <= 120
        && request.resource.data.activityDays is list
        && request.resource.data.activityDays.size() > 0
        && request.resource.data.activityDays.size() <= 7
        && request.resource.data.pdfFileName is string
        && request.resource.data.pdfFileName.matches('shalva-signed-form-[A-Za-z0-9]+[.]pdf')
        && request.resource.data.pdfStoragePath is string
        && request.resource.data.pdfStoragePath.matches('signedForms/[A-Za-z0-9]+/shalva-signed-form-[A-Za-z0-9]+[.]pdf')
        // The drawn signature (a PNG data-URL) is required, capped in size.
        && request.resource.data.signature is string
        && request.resource.data.signature.size() > 0
        && request.resource.data.signature.size() <= 300000
        // The volunteer must have ticked the agreement box.
        && request.resource.data.agreed == true
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // Public uploaded police checks: anyone with the link may submit one (create only);
    // only an admin may read / manage them.
    match /policeForms/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'registrantId', 'fullName', 'idNumber',
            'fileStoragePath', 'fileName', 'createdAt'
          ])
        && request.resource.data.keys().hasAll([
            'registrantId', 'fullName', 'idNumber',
            'fileStoragePath', 'fileName', 'createdAt'
          ])
        && request.resource.data.registrantId is string
        && request.resource.data.registrantId.size() <= 120
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 120
        && request.resource.data.idNumber is string
        && request.resource.data.idNumber.matches('[0-9]{9}')
        && request.resource.data.fileStoragePath is string
        && request.resource.data.fileStoragePath.matches('policeForms/[A-Za-z0-9]+/shalva-police-form-[A-Za-z0-9]+[.][A-Za-z0-9]+')
        && request.resource.data.fileName is string
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // Public uploaded medical checks: anyone with the link may submit one (create only);
    // only an admin may read / manage them.
    match /medicalForms/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'registrantId', 'fullName', 'idNumber',
            'fileStoragePath', 'fileName', 'createdAt'
          ])
        && request.resource.data.keys().hasAll([
            'registrantId', 'fullName', 'idNumber',
            'fileStoragePath', 'fileName', 'createdAt'
          ])
        && request.resource.data.registrantId is string
        && request.resource.data.registrantId.size() <= 120
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 120
        && request.resource.data.idNumber is string
        && request.resource.data.idNumber.matches('[0-9]{9}')
        && request.resource.data.fileStoragePath is string
        && request.resource.data.fileStoragePath.matches('medicalForms/[A-Za-z0-9]+/shalva-medical-form-[A-Za-z0-9]+[.][A-Za-z0-9]+')
        && request.resource.data.fileName is string
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // Volunteers: active users may read (the guide screens read the whole list
    // and filter client-side). Only an admin may write — guides never edit
    // volunteers in the app, so this stays admin-only on the server too.
    match /volunteers/{id} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Attendance: active users may read (read scoping is intentionally UNCHANGED
    // here — it is tightened in a later step). Admins manage everything; a guide
    // may only write attendance for THEIR OWN group, with strict server-side
    // validation (canonical groupId, real non-Saturday dateKey, typed fields,
    // immutable identity), not just hidden in the UI.
    match /attendance/{id} {
      allow read: if isActiveUser();

      // Create: admin, or a guide creating a strict, canonical own-group record.
      allow create: if isAdmin() || guideAttendanceCreate(id, request.resource.data);

      // Update: admin, or a guide editing an existing own-group record with the
      // identity (groupId / volunteerId / dateKey) left unchanged.
      allow update: if isAdmin()
        || guideAttendanceUpdate(request.resource.data, resource.data);

      // Delete: admin, or a guide removing an own-group record with a real,
      // non-Saturday dateKey, whose volunteer also belongs to that group. No
      // cross-group delete; a Saturday / missing / malformed dateKey record can
      // only be removed by an admin (guides never touch it).
      allow delete: if isAdmin()
        || (hasRole('guide')
            && isRealNonSaturdayDateKey(resource.data.get('dateKey', ''))
            && isGuideOfGroup(resource.data.get('groupId', ''))
            && exists(/databases/$(database)/documents/volunteers/$(resource.data.get('volunteerId', '')))
            && get(/databases/$(database)/documents/volunteers/$(resource.data.get('volunteerId', ''))).data.get('groupId', '') == resource.data.get('groupId', ''));
    }

    // Events: active users may read; only an admin may write.
    match /events/{id} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Programs: anyone may read (shown on the public landing page); only an admin may write.
    match /programs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }



    // User profiles / roles: a user may always read their own document (the app
    // gate needs it); active users may read others.
    //
    // Writes are admin-only, with self-guards enforced here (not just in the
    // UI): an admin can't change their OWN role or disabled flag, and can't
    // delete their own account. NOTE: the "don't remove the last admin" rule is
    // enforced only in the UI — strong enforcement needs a counter/transaction
    // or a backend.
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isActiveUser();

      allow create: if isAdmin();

      allow update: if isAdmin()
        && (request.auth.uid != uid
            || (request.resource.data.get('role', '') == resource.data.get('role', '')
                && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)));

      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Guide ↔ group mapping: active users read; only an admin writes. (A
    // disabled user never needs this — the access gate only reads users/{uid}.)
    match /guides/{uid} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Everything not matched above is denied by default.
  }
}
