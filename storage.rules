rules_version = '2';

// Cloud Storage rules for Kehila Hub.
service firebase.storage {
  match /b/{bucket}/o {

    // The signed-in user's Firestore profile (role / disabled live there).
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // An active (non-disabled) admin — the only role allowed to upload.
    // Mirrors the isAdmin() check in firestore.rules so the UI restriction is
    // actually enforced on the server, not just hidden in the interface.
    function isActiveAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().get('role', '') == 'admin'
        && profile().get('disabled', false) != true;
    }

    // Group cover images. Anyone may read them (the public showcase shows
    // them), but only an active admin may upload — and only an image file up
    // to 5MB.
    match /groups/{groupId}/{fileName} {
      allow read: if true;
      allow write: if isActiveAdmin()
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Signed volunteer forms. The public signing page may upload one PDF, and
    // admins may open it from registrations management.
    match /signedForms/{formId}/{fileName} {
      allow create: if fileName.matches('shalva-signed-form-[A-Za-z0-9]+[.]pdf')
                    && request.resource.size <= 8 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
      allow read, delete: if isActiveAdmin();
      allow update: if false;
    }

    // Public uploaded police forms. Anyone may upload up to 8MB PDF/image.
    match /policeForms/{formId}/{fileName} {
      allow create: if fileName.matches('shalva-police-form-[A-Za-z0-9]+[.][A-Za-z0-9]+')
                    && request.resource.size <= 8 * 1024 * 1024
                    && request.resource.contentType.matches('(application/pdf|image/.*)');
      allow read, delete: if isActiveAdmin();
      allow update: if false;
    }

    // Public uploaded medical forms. Anyone may upload up to 8MB PDF/image.
    match /medicalForms/{formId}/{fileName} {
      allow create: if fileName.matches('shalva-medical-form-[A-Za-z0-9]+[.][A-Za-z0-9]+')
                    && request.resource.size <= 8 * 1024 * 1024
                    && request.resource.contentType.matches('(application/pdf|image/.*)');
      allow read, delete: if isActiveAdmin();
      allow update: if false;
    }

    // Event images. Anyone may read them, but only an active admin may upload — and only an image file up to 5MB.
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isActiveAdmin()
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Program images. Anyone may read them, but only an active admin may upload — and only an image file up to 5MB.
    match /programs/{programId}/{fileName} {
      allow read: if true;
      allow write: if isActiveAdmin()
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }


    // Everything else stays denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
